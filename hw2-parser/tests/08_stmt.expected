<func_def>intmain(){<scalar_decl>inti;</scalar_decl><stmt>if(<expr>i</expr>){<stmt><expr><expr>i</expr>=<expr>1</expr></expr>;</stmt>}else{}</stmt><stmt>while(<expr><expr>i</expr><<expr>10</expr></expr>)<stmt><expr><expr>i</expr>++</expr>;</stmt></stmt><stmt>do<stmt>{<stmt><expr><expr>i</expr>--</expr>;</stmt>}</stmt>while(<expr>i</expr>);</stmt><stmt>for(<expr><expr>i</expr>=<expr>0</expr></expr>;<expr><expr>i</expr><<expr>3</expr></expr>;<expr><expr>i</expr>++</expr>)<stmt>{<stmt>continue;</stmt>}</stmt></stmt><stmt>for(;;)<stmt>break;</stmt></stmt><stmt>switch(<expr>i</expr>){case<expr>1</expr>:case<expr>2</expr>:<stmt><expr><expr>i</expr>=<expr>2</expr></expr>;</stmt><stmt>break;</stmt>default:}</stmt><stmt>switch(<expr>i</expr>){}</stmt><stmt>{<scalar_decl>intj;</scalar_decl><stmt><expr><expr>j</expr>=<expr>i</expr></expr>;</stmt>}</stmt><stmt>return;</stmt><stmt>return<expr>i</expr>;</stmt>}</func_def>